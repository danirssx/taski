{
  "name": "taski",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": "^24.11.1 || ^26.3.0",
    "npm": ">=11"
  },
  "packageManager": "npm@11.16.0",
  "scripts": {
    "dev": "wrangler dev --local",
    "build": "wrangler deploy --dry-run --outdir dist",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "db:check": "wrangler d1 execute DB --local --command \"SELECT bootstrap_version FROM taski_bootstrap WHERE id = 1\"",
    "test": "node --test tests/*.test.mjs",
    "onboarding:check": "node scripts/verify-onboarding.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.core.json",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check": "npm run typecheck && npm run check:boundaries && npm test && npm run build",
    "docs:check": "python3 scripts/check_docs.py && python3 scripts/check_linear_baseline.py"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261113.1",
    "typescript": "6.0.3",
    "wrangler": "4.161.0"
  }
}
